dist/
build/
coverage/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.backup
*.bak

# Private keys
*.pem
*.key
*.p12

# Local config overrides
config.local.js
